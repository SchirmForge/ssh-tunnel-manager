# SSH Tunnel Manager - live test target configuration (TEMPLATE)
#
# Copy this file to `.local/testing/ssh-target.env` and fill in real values:
#
#     mkdir -p .local/testing
#     cp docs/testing/ssh-target.env.template .local/testing/ssh-target.env
#     chmod 600 .local/testing/ssh-target.env
#     $EDITOR .local/testing/ssh-target.env
#
# `.local/` is gitignored in its entirety. Host names, user names, passwords,
# TOTP secrets and private keys belong ONLY there -- never in a committed file,
# script, test or CI workflow.
#
# The live tests (`cargo test -- --ignored`, or `make test-live`) read this file.
# If it is missing, or a given account is not configured, the tests that need it
# SKIP rather than fail -- so `cargo test` is always safe on a fresh clone.

# --- Target SSH server ------------------------------------------------------

SSH_TUNNEL_TEST_HOST=
SSH_TUNNEL_TEST_PORT=22

# A port on the target reachable from the target itself, used to prove that a
# forwarded connection actually carries bytes. The target's own sshd is the
# convenient choice: the test reads the "SSH-2.0-..." banner back through the
# tunnel, so nothing extra has to be deployed.
SSH_TUNNEL_TEST_FORWARD_HOST=127.0.0.1
SSH_TUNNEL_TEST_FORWARD_PORT=22

# --- Account 1: key authentication ------------------------------------------
# An account whose authorized_keys accepts the key below.
# Keep the key inside .local/testing/ too, not in ~/.ssh, so the setup is
# self-contained and cannot pick up your personal keys.

SSH_TUNNEL_TEST_USER_KEY=
SSH_TUNNEL_TEST_KEY_PATH=

# Optional: an encrypted key plus its passphrase, to cover the passphrase
# prompt and the wrong-passphrase retry path. Leave blank to skip those.
SSH_TUNNEL_TEST_ENCRYPTED_KEY_PATH=
SSH_TUNNEL_TEST_KEY_PASSPHRASE=

# --- Account 2: password authentication -------------------------------------

SSH_TUNNEL_TEST_USER_PASSWORD=
SSH_TUNNEL_TEST_PASSWORD=

# --- Account 3: two-factor (publickey + keyboard-interactive) ---------------
# The TOTP secret is the base32 string from the authenticator enrolment, so the
# tests can generate valid codes and exercise the retry path that was fixed in
# v0.1.10.

SSH_TUNNEL_TEST_USER_2FA=
SSH_TUNNEL_TEST_2FA_PASSWORD=
SSH_TUNNEL_TEST_TOTP_SECRET=
